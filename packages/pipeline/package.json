    "@qiushui-airadar/source-adapters": "workspace:*",
    "@earendil-works/pi-ai": "0.85.1",
    "@mozilla/readability": "0.6.0",
    "fast-xml-parser": "5.11.1",
    "linkedom": "0.18.13",
    "yaml": "^2.9.1",
    "zod": "^4.1.12"
  }
}
