{
  "name": "qiushuiai-airadar",
  "private": true,
  "version": "0.7.2",
  "type": "module",
  "packageManager": "pnpm@10.34.1",
  "engines": {
    "node": ">=24.21.0 <25"
  },
  "scripts": {
    "build": "pnpm -r --if-present build",
    "accept:rss": "tsx scripts/accept-rss-e2e.ts",
    "accept:chinese-platforms": "tsx scripts/accept-chinese-platforms-e2e.ts",
    "accept:operations": "tsx scripts/accept-operations-e2e.ts",
    "accept:secrets": "tsx scripts/scan-acceptance-secrets.ts",
    "accept:summary": "tsx scripts/summarize-acceptance.ts",
    "accept:x-youtube": "tsx scripts/accept-x-youtube-e2e.ts",
    "check": "pnpm lint && pnpm typecheck && pnpm test && pnpm build && pnpm smoke:source && pnpm smoke:built && pnpm smoke:deployed",
    "dev": "pnpm --filter @qiushuiai-airadar/web dev",
    "dev:cli": "pnpm --filter @qiushuiai-airadar/cli dev",
    "dev:service": "tsx scripts/serve-single-table.ts",
    "collect:v2": "tsx scripts/run-single-table.ts",
    "serve:v2": "tsx scripts/serve-single-table.ts",
    "lint": "eslint .",
    "smoke:source": "tsx scripts/source-smoke.ts",
    "smoke:built": "node apps/cli/dist/cli.js status",
    "smoke:deployed": "tsx scripts/deployed-cli-smoke.ts",
    "typecheck": "tsc -b --pretty false",
    "test": "vitest run",
    "format:check": "prettier --check .",
    "format": "prettier --write .",
    "release:local": "pnpm build && node scripts/pack-release.mjs",
    "release:remote": "node scripts/publish-release.mjs"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ],
    "overrides": {
      "tinyglobby>picomatch": "4.0.4",
      "@babel/helper-compilation-targets>browserslist": "4.28.7"
    }
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.13.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "esbuild": "0.28.2",
    "eslint": "^10.10.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.6",
    "globals": "^17.12.0",
    "prettier": "^3.9.6",
    "tsx": "^4.23.13",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.70.0",
    "vitest": "^5.0.0"
  }
}
